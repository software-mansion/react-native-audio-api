{
  "name": "react-native-audio-api-monorepo",
  "version": "0.0.0",
  "packageManager": "pnpm@12.10.1",
  "private": true,
  "scripts": {
    "check": "bash scripts/run-packages.sh check",
    "test": "bash scripts/run-packages.sh test",
    "build": "pnpm --filter react-native-audio-api build && pnpm --filter react-native-audio-worklets build",
    "format": "pnpm -r --parallel format",
    "clean": "del-cli packages/**/android/build apps/**/android/build apps/**/android/app/build apps/**/ios/build packages/**/lib node_modules apps/**/node_modules packages/**/node_modules",
    "android": "pnpm --filter fabric-example android",
    "ios": "pnpm --filter fabric-example ios",
    "server": "pnpm --filter fabric-example server",
    "start": "pnpm --filter fabric-example start",
    "setup:clangd": "bash packages/react-native-audio-api/common/cpp/clangd/generate-and-copy.sh && bash packages/react-native-audio-worklets/common/cpp/clangd/generate-and-copy.sh",
    "setup:clangd:clean": "bash packages/react-native-audio-api/common/cpp/clangd/generate-and-copy.sh --clean && bash packages/react-native-audio-worklets/common/cpp/clangd/generate-and-copy.sh",
    "docs:internal": "pnpm --filter internaldocs start",
    "docs:internal:build": "pnpm --filter internaldocs build"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@types/raf": "^3.4.3",
    "commitlint": "catalog:",
    "del-cli": "^5.1.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "lefthook": "catalog:",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
