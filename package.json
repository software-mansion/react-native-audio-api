{
  "name": "react-native-audio-api-monorepo",
  "version": "0.0.0",
  "packageManager": "pnpm@12.10.1",
  "private": true,
  "scripts": {
    "build": "pnpm --filter react-native-audio-api build && pnpm --filter react-native-audio-worklets build",
    "lint": "pnpm -r --parallel lint",
    "format": "pnpm -r --parallel format",
    "format:check": "pnpm --filter react-native-audio-api format:check && pnpm --filter react-native-audio-worklets format:check",
    "clean": "del-cli packages/**/android/build apps/**/android/build apps/**/android/app/build apps/**/ios/build packages/**/lib node_modules apps/**/node_modules packages/**/node_modules",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm --filter react-native-audio-api test",
    "check-audio-enum-sync": "bash packages/react-native-audio-api/scripts/check-enum-sync.sh",
    "android": "pnpm --filter fabric-example android",
    "ios": "pnpm --filter fabric-example ios",
    "server": "pnpm --filter fabric-example server",
    "start": "pnpm --filter fabric-example start",
    "validate:fast": "bash scripts/validate.sh --fast",
    "validate:cpp": "bash scripts/validate.sh --cpp",
    "validate:cpp-extended": "bash scripts/validate.sh --cpp-extended",
    "validate:cpp-full": "bash scripts/validate.sh --cpp-full",
    "validate:android": "bash scripts/validate.sh --android",
    "validate:ios": "bash scripts/validate.sh --ios",
    "validate:full": "bash scripts/validate.sh --full",
    "setup:clangd": "bash packages/react-native-audio-api/common/cpp/clangd/generate-and-copy.sh",
    "setup:clangd:clean": "bash packages/react-native-audio-api/common/cpp/clangd/generate-and-copy.sh --clean",
    "docs:internal": "bash -c 'cd packages/internaldocs && yarn start'",
    "docs:internal:build": "bash -c 'cd packages/internaldocs && yarn build'"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@evilmartians/lefthook": "catalog:",
    "@react-native/eslint-config": "catalog:",
    "@types/raf": "^3.4.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "commitlint": "catalog:",
    "del-cli": "^5.1.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-jsdoc": "^50.2.2",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "hermes-eslint": "^0.26.0",
    "prettier": "catalog:",
    "prettier-plugin-jsdoc": "^1.3.0",
    "typescript": "catalog:"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "eslintConfig": {
    "root": true,
    "parserOptions": {
      "requireConfigFile": false
    },
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "react/react-in-jsx-scope": "off",
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
