ENV['RCT_NEW_ARCH_ENABLED'] = '1'

# Uncomment when building for macOS with Catalyst
# ENV['RCT_BUILD_FROM_SOURCE'] = '1'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Set by the app target from the RN CLI; the test host (declared after it) and
# post_install reuse it so every target registers React Native from the same path.
react_native_path = nil

target 'FabricExample' do
  config = use_native_modules!
  react_native_path = config[:reactNativePath]

  use_react_native!(
    :path => react_native_path,
    :hermes_enabled => true,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => true
  )
end

# Minimal XCTest host: links RNAudioAPI + React Native core only
target 'FabricExampleTestHost' do
  pod 'RNAudioAPI', :path => '../../../packages/react-native-audio-api'

  use_react_native!(
    :path => react_native_path,
    :hermes_enabled => true,
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => false
  )

  target 'FabricExampleTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  react_native_post_install(
    installer,
    react_native_path,
    :mac_catalyst_enabled => false,
    :ccache_enabled => ENV['USE_CCACHE'] == '1'
  )

  # react_native_post_install resolves the path to pnpm's store folder (with its hash)
  # before writing REACT_NATIVE_PATH. Write the link instead to keep the pbxproj stable.
  installer.aggregate_targets.map(&:user_project).uniq.each do |project|
    project.build_configurations.each do |config|
      config.build_settings['REACT_NATIVE_PATH'] = "${PODS_ROOT}/../#{react_native_path}"
    end
    project.save
  end

  # TODO: Remove this loop once a `react-native-svg` release includes
  # software-mansion/react-native-svg#3022 (`:ios => "15.1"` in RNSVG.podspec)
  # *and* `pod install` without this block leaves no
  # IPHONEOS_DEPLOYMENT_TARGET below 15.0 in Pods.xcodeproj (in particular
  # RNSVG-RNSVGFilters). Xcode 27 rejects targets under 15.0;
  # react_native_post_install only bumps each pod's native_target, so
  # CocoaPods resource-bundle targets keep the podspec min (12.4 in 15.15.4).
  min_ios = min_ios_version_supported
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      next if current && current.to_f >= min_ios.to_f

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios
    end
  end
end
