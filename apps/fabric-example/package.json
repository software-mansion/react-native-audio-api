{
  "name": "fabric-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build-and-run:android": "bash scripts/build-and-run-android.sh",
    "build-and-run:ios": "bash scripts/build-and-run-ios.sh",
    "build:android": "bash scripts/build-android.sh",
    "build:ios": "bash scripts/build-ios.sh",
    "android": "bash scripts/build-and-run-android.sh",
    "ios": "bash scripts/build-and-run-ios.sh",
    "journal-execution": "node scripts/journal-execution.mjs",
    "journal-view": "node scripts/journal-view.mjs",
    "lint": "eslint .",
    "log:stream:ios": "bash scripts/log-stream-ios.sh",
    "run:android": "bash scripts/run-android.sh",
    "run:ios": "bash scripts/run-ios.sh",
    "start": "react-native start",
    "test": "jest",
    "server": "node --env-file-if-exists=.env.local server/realtime-token-server.mjs",
    "test:server": "node --test server/realtime-token-server.test.mjs"
  },
  "dependencies": {
    "common-app": "workspace:*",
    "lucide-react-native": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-svg": "catalog:"
  },
  "devDependencies": {
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "react-native-audio-api": {
    "enableFFmpeg": true
  },
  "reactNativeVectorIcons": {
    "fontDir": "./assets/fonts"
  }
}
